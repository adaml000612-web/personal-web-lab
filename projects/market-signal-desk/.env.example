# Administrator access. ADMIN_EMAIL is the only ChatGPT account allowed into /admin.
# ADMIN_SECRET must be a random value of at least 32 characters and encrypts saved API keys.
ADMIN_EMAIL=
ADMIN_SECRET=

# Optional environment fallback. The admin console takes priority when configured.
DEEPSEEK_API_KEY=
DEEPSEEK_AGENT_MODEL=deepseek-v4-flash

# Legacy optional AI enhancement.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.6-luna
